{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bali-discount",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
